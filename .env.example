# FilingsLab — Environment Variables
# Copy this file to .env and adjust values as needed.

# Database (used by backend — automatically configured when using Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/filingslab

# App settings
DEBUG=false

# ── API authentication (REQUIRED for the trading control surface) ─────────────
# Shared operator bearer token. It gates every mutating route and the whole
# auto-trader / paper-portfolio surface:
#   POST   /api/feed/execute
#   DELETE /api/feed/position/{ticker}
#   GET    /api/feed/portfolio, /api/feed/broker/status
#   GET/POST /api/feed/auto-trader/config
#   POST   /api/feed/auto-trader/run
#   GET    /api/feed/auto-trader/log
# Leave it EMPTY and those routes return 503 (disabled) — never open.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit the real value; it belongs in .env, which is gitignored.
API_TOKEN=

# Networks whose X-Real-IP / X-Forwarded-For headers may be believed when
# choosing a rate-limit bucket. Defaults cover loopback and the Docker bridge,
# so the bundled nginx works while a caller hitting port 8000 directly from the
# internet cannot spoof themselves a fresh bucket per request.
# TRUSTED_PROXY_NETWORKS=["127.0.0.0/8","172.16.0.0/12"]

# CORS origins (comma-separated list of allowed frontend origins)
# ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Finance / analytics settings
RISK_FREE_RATE=0.04
DEFAULT_MC_RUNS=500
MAX_MC_RUNS=2000

# ── Financial Modeling Prep (Live Feed) ───────────────────────────────────────
# Free API key at https://financialmodelingprep.com (250 req/day)
# Provides real congressional STOCK Act trade disclosures (Senate + House)
FMP_API_KEY=

# ── Alpaca (Paper / Live Trading) ─────────────────────────────────────────────
# Free paper trading account at https://alpaca.markets
# Get API key + secret from the Alpaca dashboard
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
